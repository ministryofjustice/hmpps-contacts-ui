{% extends "../../partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set title = "Are you sure you want to delete this prisoner restriction?" %}
{% set pageTitle = title + " - Manage prisoner restrictions - DPS" %}
{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Manage prisoner restrictions</span>
      <h1 class="govuk-heading-l" data-qa="main-heading">{{ title }}</h1>
      <form method="POST">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        {{ govukSummaryList({
          rows: [
            { key: { text: "Restriction type" }, value: { text: restriction.restrictionTypeDescription } },
            { key: { text: "Start date" }, value: { text: restriction.effectiveDate | formatDate('d/M/yyyy') } },
            { key: { text: "Expiry date" }, value: { text: (restriction.expiryDate | formatDate('d/M/yyyy')) if restriction.expiryDate else 'Not provided' } },
            { key: { text: "Comments" }, value: { text: restriction.commentText or 'Not provided' } }
          ]
        }) }}
        <div class="govuk-button-group">
          {{ govukButton({
            text: "Yes, delete",
            type: "submit",
            classes: 'govuk-button--warning',
            attributes: {"data-qa": "continue-button"},
            preventDoubleClick: true
          }) }}
          {{ govukButton({
            text: "No, do not delete",
            classes: 'govuk-button--secondary',
            attributes: {"data-qa": "cancel-button"},
            href: navigation.cancelButton
          }) }}
        </div>
      </form>
    </div>
  </div>
{% endblock %}
